{
  "name": "cli-task-manager",
  "version": "1.0.0",
  "description": "CLI Task Manager — aplikasi pengelola tugas berbasis terminal",
  "license": "ISC",
  "author": "Linda Angellina",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "npm install && tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^26.2.0"
  }
}